rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow read and write to the "users" collection if authenticated
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Restrict access to other collections
    match /{document=**} {
      allow read, write: if false;  // No access to other collections
    }
  }
}
